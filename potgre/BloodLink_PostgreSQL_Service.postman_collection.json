      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@bloodlink.com\",\n  \"password\": \"Password123!\",\n  \"username\": \"donor_user\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+34612345678\"\n}"
            },
            "url": {
              "raw": "http://localhost:3007/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3007",
              "path": ["api", "auth", "register"]
