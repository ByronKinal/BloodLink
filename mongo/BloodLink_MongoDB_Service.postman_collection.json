  "item": [
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Get all appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3006/api/appointments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3006",
              "path": ["api", "appointments"]
            }
          }
        },
        {
          "name": "Create appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id\",\n  \"appointmentDate\": \"2026-05-15T10:00:00Z\",\n  \"status\": \"scheduled\"\n}"
            },
